        "# ---------------------------------------------------------\n",
        "# 4. KDE of log(Foreign Gift Amount), overall and by Gift Type\n",
        "# ---------------------------------------------------------\n",
        "df['Log_giftamount'] = np.log(df['Foreign Gift Amount'])\n",
        "x = df['Log_giftamount'].dropna()  # drop NaNs from log of zero/negative values\n",
        "\n",
        "# Hand-built KDE (matches class slides)\n",
        "N = len(x)\n",
        "sample_sd = np.std(x, ddof=1)\n",
        "h_s = 1.06 * sample_sd * N**(-1 / 5)\n",
        "grid = np.linspace(x.min() - 2 * sample_sd, x.max() + 2 * sample_sd, 500)\n",
        "\n",
        "def normal_kernel(center, bandwidth):\n",
        "    z = (grid - center) / bandwidth\n",
        "    return np.exp(-(z**2) / 2) / (bandwidth * np.sqrt(2 * np.pi))\n",
        "\n",
        "kde = sum(normal_kernel(value, h_s) for value in x) / N\n",
        "ax = sns.lineplot(x=grid, y=kde)\n",
        "ax.set(title=\"A hand-built KDE of log(Foreign Gift Amount)\",\n",
        "       xlabel=\"log(Gift Amount)\", ylabel=\"Density\")\n",
        "plt.show()\n",
        "\n",
        "# Conditional KDE by Gift Type\n",
        "sns.kdeplot(data=df, x='Log_giftamount', hue='Gift Type')\n",
        "plt.title(\"KDE of log(Foreign Gift Amount) by Gift Type\")\n",
        "plt.xlabel(\"log(Gift Amount)\")\n",
        "plt.ylabel(\"Density\")\n",
        "plt.show()"
      ],
